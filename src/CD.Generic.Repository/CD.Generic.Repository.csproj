<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>CD.Generic.Repository</PackageId>
    <Version>3.0.0-preview.1</Version>
    <Description>Compatibility package for CD.Generic.Repository 2.x users. Migrate to CD.GenericRepository.</Description>
    <PackageTags>EntityFrameworkCore;Repository;UnitOfWork;Legacy</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CD.GenericRepository\CD.GenericRepository.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\CD.GenericRepository\icon.png" Pack="true" PackagePath="/" Link="icon.png" />
    <None Include="..\CD.GenericRepository\LICENSE.txt" Pack="true" PackagePath="/" Link="LICENSE.txt" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="_._" Pack="true" PackagePath="lib/net8.0/;lib/net9.0/;lib/net10.0/" />
  </ItemGroup>

</Project>
